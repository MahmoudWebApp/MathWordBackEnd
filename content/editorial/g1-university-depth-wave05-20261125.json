        "Title": {
          "Ar": "احتمال متوسط العينة",
          "En": "Sample mean probability"
        },
        "Question": {
          "Ar": "مجتمع طبيعي متوسطه 50 وانحرافه المعياري 12. عينة مستقلة حجمها 36. إذا كانت Φ(1)=0.8413، فما احتمال أن يزيد متوسط العينة على 52؟",
          "En": "A normal population has mean 50 and standard deviation 12. Take an independent sample of size 36. Given Φ(1)=0.8413, what is P(sample mean > 52)?"
        },
        "Options": [
          {
            "LatexCode": "0.8413",
            "IsCorrect": false,
            "ErrorType": "misconception",
            "Reason": {
              "Ar": "يمثل الطرف الأدنى.",
              "En": "Represents the lower tail."
            }
          },
          {
            "LatexCode": "0.1587",
            "IsCorrect": true,
            "ErrorType": "",
            "Reason": {
              "Ar": "",
              "En": ""
            }
          },
          {
            "LatexCode": "0.5000",
            "IsCorrect": false,
            "ErrorType": "misconception",
            "Reason": {
              "Ar": "يفترض أن الحد يساوي المتوسط.",
              "En": "Assumes the threshold is the mean."
            }
          },
          {
            "LatexCode": "0.3174",
            "IsCorrect": false,
            "ErrorType": "misconception",
            "Reason": {
              "Ar": "يحسب طرفين بدلاً من طرف واحد.",
              "En": "Counts two tails instead of one."
            }
          }
        ],
        "Hints": [
          {
            "Ar": "احسب الانحراف المعياري لتوزيع المتوسط.",
            "En": "Find the standard deviation of the sample mean."
          },
          {
            "Ar": "بعد المعيارية، اطرح الاحتمال التراكمي من واحد.",
            "En": "After standardizing, subtract the CDF value from one."
          }
        ],
        "Solution": {
          "Idea": {
            "Ar": "متوسط العينة طبيعي بخطأ معياري أصغر من انحراف المجتمع.",
            "En": "The sample mean is normal with a smaller standard error than the population standard deviation."
          },
          "FormulaLatex": "Z=\\frac{\\bar X-\\mu}{\\sigma/\\sqrt{n}}",
          "Steps": [
            {
              "Ar": "احسب الخطأ المعياري 12/6=2.",
              "En": "Compute the standard error: 12/6=2."
            },
            {
              "Ar": "القيمة المعيارية للحد 52 هي (52−50)/2=1.",
              "En": "Standardize threshold 52: (52−50)/2=1."
            },
            {
              "Ar": "استخدم المتممة لأن المطلوب الطرف الأعلى.",
              "En": "Use the complement for the upper tail."
            }
          ],
          "Substitution": {
            "Ar": "1−0.8413=0.1587",
            "En": "1−0.8413=0.1587"
          },
          "Result": {
            "Ar": "0.1587",
            "En": "0.1587"
          },
          "Unit": {
            "Ar": "بلا وحدة",
            "En": "Unitless"
          },
          "Verification": {
            "Ar": "مجموع احتمالي الطرفين يساوي 1.",
            "En": "Both tail regions together sum to 1."
          },
          "CommonError": {
            "Ar": "لا تستخدم انحراف المجتمع مباشرة في معيار متوسط العينة.",
            "En": "Do not use the population standard deviation directly for the sample mean."
          }
        }
      }
