          {
            "Ar": "ربّع الخطأين ثم اجمع وخذ الجذر.",
            "En": "Square both errors, add, then take the root."
          }
        ],
        "Solution": {
          "Idea": {
            "Ar": "عند الاستقلال تتجمع التباينات حتى عند طرح المتغيرين.",
            "En": "Under independence, variances add even when variables are subtracted."
          },
          "FormulaLatex": "SE(\\bar X-\\bar Y)=\\sqrt{SE_X^2+SE_Y^2}",
          "Steps": [
            {
              "Ar": "ربّع الخطأين المعياريين.",
              "En": "Square both standard errors."
            },
            {
              "Ar": "اجمع التباينين وخذ الجذر.",
              "En": "Add variances and take the square root."
