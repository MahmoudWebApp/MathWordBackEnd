<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>fb673b4c-77e1-4491-af51-642c080c4411</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerfileContext>.</DockerfileContext>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="tests/**/*.cs" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="content/editorial/g1-structured-amendments-wave*-20261124.json;content/editorial/g1-existing-hint-candidates-20261124.json;content/editorial/g1-hint-held-review-20261124.json;content/editorial/g1-taxonomy-clearances-20261125.json;content/editorial/g1-gap-wave-0*-20261124.json;content/editorial/g1-primary-early-and-final-grade-gap-20261124.json;content/editorial/g1-grade-depth-wave04-20261125.json;content/editorial/g1-university-depth-wave05-20261125.json" LogicalName="MathWorld.ReviewedBank.%(Filename)%(Extension)" />
		<EmbeddedResource Include="content/editorial/g1-track-draft-batch-20261124.json" LogicalName="MathWorld.G1.TrackDraftBatch" />
		<EmbeddedResource Include="assets/branding/mathworld-report-mark.png" LogicalName="MathWorld.Brand.Logo.png" />
		<EmbeddedResource Include="assets/fonts/IBMPlexSansArabic-Regular.ttf" LogicalName="MathWorld.Brand.PdfArabicRegular.ttf" />
		<EmbeddedResource Include="assets/fonts/IBMPlexSansArabic-SemiBold.ttf" LogicalName="MathWorld.Brand.PdfArabicSemiBold.ttf" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Google.Apis.Auth" Version="1.74.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.0" />
		<PackageReference Include="QuestPDF" Version="2026.9.2" />
		<PackageReference Include="ClosedXML" Version="0.105.1" />
		<PackageReference Include="MeiliSearch" Version="0.15.0" />
		<PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
		<PackageReference Include="Polly" Version="8.6.6" />
		<PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="7.0.0" />
	</ItemGroup>

</Project>