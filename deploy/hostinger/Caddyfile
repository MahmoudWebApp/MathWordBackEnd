# One official HTTPS domain; Caddy obtains and renews TLS certificates.
# ASP.NET needs its /api prefix intact: use handle, NOT handle_path.
{$MATHWORLD_DOMAIN} {
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
    }

    @api path /api/*
    handle @api {
        reverse_proxy api:8080
    }

    handle {
        reverse_proxy web:3000
    }
}
