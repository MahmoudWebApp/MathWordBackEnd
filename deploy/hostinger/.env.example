# Copy to .env on the VPS only, with chmod 600. NEVER commit real credentials.
# The final one official DNS hostname, without https://
MATHWORLD_DOMAIN=mathworld.example.com

POSTGRES_DB=mathworld
POSTGRES_USER=mathworld
# Long random password. A semicolon inside this value requires Npgsql
# connection-string quoting; prefer a URL-safe random password.
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_LONG_RANDOM_SECRET

# A different random signing key of at least 32 UTF-8 bytes.
JWT_KEY=REPLACE_WITH_ANOTHER_LONG_RANDOM_SIGNING_KEY
JWT_ISSUER=MathWorldAPI
JWT_AUDIENCE=MathWorldClient

# Register the official HTTPS domain with Google before enabling OAuth.
SOCIAL_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
